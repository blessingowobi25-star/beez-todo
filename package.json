{
  "name": "beeztodo-app",
  "private": true,
  "version": "1.0.0",
  "description": "Beez - a To-Do list app with notes, focus timer and stats. Built with React + TypeScript + Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run --testTimeout=20000 --hookTimeout=20000",
    "test:app": "vitest run src/tests/App.test.tsx",
    "test:app:verbose": "vitest run src/tests/App.test.tsx --reporter=verbose --testTimeout=8000 --hookTimeout=8000",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
